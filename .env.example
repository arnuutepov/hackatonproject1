# Example only: .env is NOT loaded automatically. Set process environment variables.
# template: offline local replies, no network; responses: opt-in Responses API.
COPILOT_DRAFT_PROVIDER=template
COPILOT_MODEL=
OPENAI_API_KEY=
COPILOT_RESPONSES_URL=https://api.openai.com/v1/responses
COPILOT_DRAFT_TIMEOUT=4
# Exact-match support templates can avoid a model call. No game actions promised.
COPILOT_VERIFIED_TEMPLATES=on
# Optional verified, model-specific rates. Missing prices leave cost unmeasured.
COPILOT_PRICING_FILE=
# Optional local operator database. Default: outputs/operator/workspace.sqlite3.
# Contains messages and edit history; never commit or publish it.
COPILOT_OPERATOR_DB=

# Operator security (0.9.0)
# Default is required; local is an explicit loopback-only development bypass.
COPILOT_AUTH_MODE=required
COPILOT_AUTH_DB=
# Only for HTTP on a real loopback peer; leave unset for HTTPS.
COPILOT_INSECURE_LOCAL_HTTP=
COPILOT_PUBLIC_ORIGIN=
# Generate independent secrets locally; never commit them.
COPILOT_TRIAGE_TOKEN=
COPILOT_GAME_HMAC_KEYS=

# Organizational OIDC mode: configure the IdP and proxy before enabling.
# See deploy/settings.env.example and docs/production-access.md.
COPILOT_OIDC_ISSUER=
COPILOT_OIDC_CLIENT_ID=
COPILOT_OIDC_JWKS_URL=
COPILOT_OIDC_GROUP_ROLES=
COPILOT_OIDC_MFA_ACRS=
COPILOT_SSO_PROXY_CIDRS=

# Audit chain. ed25519 (default) is publicly verifiable; hmac needs the secret to verify.
# Without a key an Ed25519 key is created beside the database: demo only, keep production keys off that volume.
COPILOT_CHAIN_SIGNER=ed25519
COPILOT_CHAIN_PRIVATE_KEY=
COPILOT_CHAIN_KEY_FILE=
COPILOT_CHAIN_SECRET=
COPILOT_CHAIN_PREVIOUS_SECRETS=
# Pin the expected genesis key; without it a chain rebuilt under a new key passes for an outside verifier.
COPILOT_CHAIN_PUBLIC_KEY=
COPILOT_CHAIN_ID=
# Defaults: outputs/chain-*.jsonl, or beside a custom COPILOT_OPERATOR_DB.
COPILOT_CHAIN_MIRROR=
COPILOT_CHAIN_ANCHORS=
# Demo only: allows `make chain-tamper` to corrupt the chain.
COPILOT_CHAIN_TAMPER_DEMO=

# Capybara MVP: explicit third-party opt-in; key stays on the server.
# Set COPILOT_DRAFT_PROVIDER=capybara to enable; template remains default.
CAPYBARA_API_KEY=
CAPYBARA_API_KEY_FILE=
COPILOT_CAPYBARA_MODEL=gemini-3.8-flash
